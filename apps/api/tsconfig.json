{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",

    "types": ["jest", "node", "multer"],
    "outDir": "./dist",

    "rootDir": ".",
    "preserveSymlinks": true,

    "paths": {
      "@generated": ["./generated/index"],
      "@generated/*": ["./generated/*"],
      "@src/*": ["./src/*"]
    },

    "sourceMap": true,
    "declaration": true,
    "incremental": true,

    // Обязательно для NestJS (Декораторы и Инъекция зависимостей)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Совместимость и проверки
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,

    // Очистка билда
    "removeComments": true
  },
  "include": ["src/**/*", "generated/**/*", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
